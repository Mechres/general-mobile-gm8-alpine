pmos/kernel/
edge/
twrp-tree/

# Generated files and local caches
__pycache__/
*.py[cod]
*.tmp
*.bak
*~

# Private credentials and host keys (generate your own, see README)
*_key
*_key.pem
id_rsa
id_ed25519
**/authorized_keys
.env*
